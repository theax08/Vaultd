{%- style -%}
  .social-proof-block-{{ block.id }} {
    display: block;
    width: 100%;
  }

  .social-proof-section-{{ block.id }} {
    width: 100%;
    padding: 72px 40px;
    box-sizing: border-box;
    text-align: center;
  }

  .social-proof-card-{{ block.id }} {
    box-sizing: border-box;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .social-proof-card-{{ block.id }}.is-linked {
    cursor: pointer;
  }

  .social-proof-card-{{ block.id }}[hidden] {
    display: none;
  }

  /* Design 1: Simple text */
  .sp-count-{{ block.id }} {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .sp-count-label-{{ block.id }} {
    margin: 6px 0 0 0;
    font-size: 13px;
    opacity: 0.7;
  }

  /* Design 2: Avatar stack */
  .sp-avatars-{{ block.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .sp-avatar-{{ block.id }} {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    border: 2px solid rgb(var(--color-background));
    margin-left: -12px;
  }
  .sp-avatar-{{ block.id }}:first-child { margin-left: 0; }

  .sp-avatar-more-{{ block.id }} {
    margin-left: 12px;
    font-size: 16px;
    opacity: 0.65;
  }

  .sp-avatars-label-{{ block.id }} {
    margin: 0 0 8px 0;
    font-size: 16px;
    opacity: 0.7;
  }

  .sp-avatars-count-{{ block.id }} {
    margin: 0;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
  }

  /* Design 3: Progress bar (limited waitlist) */
  .sp-progress-row-{{ block.id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sp-progress-track-{{ block.id }} {
    flex: 1 1 auto;
    height: 12px;
    border-radius: 999px;
    background: rgba(var(--color-foreground), 0.1);
    overflow: hidden;
  }

  .sp-progress-fill-{{ block.id }} {
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #6d5bd0, #8b3fd1);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .sp-progress-pct-{{ block.id }} {
    flex: 0 0 auto;
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
  }

  .sp-progress-spots-{{ block.id }} {
    margin: 12px 0 0 0;
    font-size: 15px;
    opacity: 0.6;
  }
{%- endstyle -%}

<div class="social-proof-block social-proof-block-{{ block.id }}">
  <div class="social-proof-section-{{ block.id }}">
    <div
      id="social-proof-card-{{ block.id }}"
      class="social-proof-card-{{ block.id }} {% if block.settings.link_to_waitlist %}is-linked{% endif %}"
      hidden
    >
      {% if block.settings.design == "simple" %}
        <p class="sp-count-{{ block.id }}" data-sp-count>0</p>
        <p class="sp-count-label-{{ block.id }}">{{ block.settings.simple_label }}</p>

      {% elsif block.settings.design == "avatars" %}
        <div class="sp-avatars-{{ block.id }}" data-sp-avatars></div>
        <p class="sp-avatars-label-{{ block.id }}">{{ block.settings.avatars_label }}</p>
        <p class="sp-avatars-count-{{ block.id }}"><span data-sp-count>0</span> in queue</p>

      {% else %}
        <div class="sp-progress-row-{{ block.id }}">
          <div class="sp-progress-track-{{ block.id }}">
            <div class="sp-progress-fill-{{ block.id }}" data-sp-progress-fill></div>
          </div>
          <strong class="sp-progress-pct-{{ block.id }}" data-sp-capacity>0%</strong>
        </div>
        <p class="sp-progress-spots-{{ block.id }}" data-sp-spots></p>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    const id = '{{ block.id }}';
    const card = document.getElementById('social-proof-card-' + id);
    if (!card) return;

    const design = '{{ block.settings.design }}';
    const staticDropId = '{{ block.settings.drop_id | escape }}';
    const linkToWaitlist = {{ block.settings.link_to_waitlist | json }};
    const pollMs = 20000;

    const countEls = card.querySelectorAll('[data-sp-count]');
    const avatarsEl = card.querySelector('[data-sp-avatars]');
    const fillEl = card.querySelector('[data-sp-progress-fill]');
    const capacityEl = card.querySelector('[data-sp-capacity]');
    const spotsEl = card.querySelector('[data-sp-spots]');

    const avatarColors = ['#8b5cf6', '#ec4899', '#06b6d4', '#22c55e', '#f97316', '#ef4444'];

    // Sans drop actif, le widget se cache sur une vraie boutique (voulu —
    // rien a annoncer). Mais dans l'editeur de theme, ca laisse le bloc
    // completement vide : rien a montrer au marchand qui parcourt les app
    // blocks, et le panneau "Ajouter une section" de Shopify affiche
    // "Aucun apercu disponible" faute de contenu rendu. On affiche donc un
    // exemple statique uniquement en design mode, adapte au design choisi.
    const isDesignMode = Boolean(window.Shopify && window.Shopify.designMode);

    function showExample() {
      card.hidden = false;
      countEls.forEach(function(el) { el.textContent = (2847).toLocaleString(); });
      if (design === 'avatars') {
        renderAvatars(['A', 'M', 'J', 'S']);
        if (avatarsEl) {
          const moreSpan = document.createElement('span');
          moreSpan.className = 'sp-avatar-more-{{ block.id }}';
          moreSpan.textContent = '+2,843';
          avatarsEl.appendChild(moreSpan);
        }
      }
      if (design === 'progress') {
        if (fillEl) fillEl.style.transform = 'scaleX(0.72)';
        if (capacityEl) capacityEl.textContent = '72%';
        if (spotsEl) spotsEl.textContent = 'Only 788 spots left';
      }
    }

    function renderAvatars(initials) {
      if (!avatarsEl) return;
      avatarsEl.innerHTML = '';
      initials.forEach(function(letter, i) {
        const span = document.createElement('span');
        span.className = 'sp-avatar-{{ block.id }}';
        span.style.background = avatarColors[i % avatarColors.length];
        span.textContent = letter;
        avatarsEl.appendChild(span);
      });
    }

    function applyStats(data) {
      if (!data || !data.drop) {
        if (isDesignMode) showExample(); else card.hidden = true;
        return;
      }
      card.hidden = false;

      countEls.forEach(function(el) {
        el.textContent = (data.waitlistCount || 0).toLocaleString();
      });

      if (design === 'avatars') {
        renderAvatars(data.recentInitials || []);
        const more = Math.max(0, (data.waitlistCount || 0) - (data.recentInitials || []).length);
        if (more > 0 && avatarsEl) {
          const moreSpan = document.createElement('span');
          moreSpan.className = 'sp-avatar-more-{{ block.id }}';
          moreSpan.textContent = '+' + more.toLocaleString();
          avatarsEl.appendChild(moreSpan);
        }
      }

      if (design === 'progress') {
        if (data.capacityPct == null) {
          // Pas de limite de waitlist configuree sur ce drop : la barre n'a pas de sens.
          if (isDesignMode) showExample(); else card.hidden = true;
          return;
        }
        const pct = Math.max(0, Math.min(100, Number(data.capacityPct) || 0));
        if (fillEl) fillEl.style.transform = 'scaleX(' + (pct / 100) + ')';
        if (capacityEl) capacityEl.textContent = pct + '%';
        if (spotsEl) spotsEl.textContent = 'Only ' + (data.spotsLeft || 0).toLocaleString() + ' spots left';
      }
    }

    async function fetchStats() {
      try {
        // Pas de ?shop= : Shopify l'ajoute deja lui-meme (signe) au proxy —
        // en rajouter un autre cote client casserait la verification de signature.
        const qs = new URLSearchParams();
        if (staticDropId) qs.set('dropId', staticDropId);
        const res = await fetch('/apps/hype/api/drop-status?' + qs.toString());
        if (!res.ok) {
          if (isDesignMode) showExample(); else card.hidden = true;
          return;
        }
        const data = await res.json();
        applyStats(data);
      } catch (e) {
        console.error('[social-proof] failed to load stats', e);
        if (isDesignMode) showExample(); else card.hidden = true;
      }
    }

    // document.querySelector prend toujours le PREMIER waitlist-block de la
    // page — sur une page avec plusieurs drops/produits (donc plusieurs
    // formulaires waitlist), cliquer le social proof du drop B faisait
    // defiler vers le formulaire du drop A. On prend plutot le plus proche
    // dans l'ordre du DOM (le suivant si il y en a un, sinon le precedent).
    function findNearestWaitlistForm() {
      const all = document.querySelectorAll('[class*="waitlist-block-"]');
      let before = null;
      for (let i = 0; i < all.length; i++) {
        const el = all[i];
        if (card.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) {
          return el;
        }
        before = el;
      }
      return before;
    }

    if (linkToWaitlist) {
      card.addEventListener('click', function() {
        const target = findNearestWaitlistForm();
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const input = target.querySelector('input[type="email"]');
          if (input) setTimeout(function() { input.focus(); }, 400);
        }
      });
    }

    fetchStats();
    setInterval(fetchStats, pollMs);
  })();
</script>

{% schema %}
{
  "name": "Social Proof Widget",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "drop_id",
      "label": "Drop ID",
      "info": "Copy the Drop ID from the Drops page in Vaultd. Leave empty to automatically use the live or next scheduled drop."
    },
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "options": [
        { "value": "simple", "label": "Simple text" },
        { "value": "avatars", "label": "Avatar stack" },
        { "value": "progress", "label": "Progress bar (limited waitlist drops)" }
      ],
      "default": "simple"
    },
    {
      "type": "checkbox",
      "id": "link_to_waitlist",
      "label": "Clicking the widget scrolls to the waitlist form",
      "default": true
    },
    {
      "type": "text",
      "id": "simple_label",
      "label": "Label (simple text design)",
      "default": "people waiting for this drop"
    },
    {
      "type": "text",
      "id": "avatars_label",
      "label": "Label (avatar stack design)",
      "default": "People are waiting"
    }
  ]
}
{% endschema %}
